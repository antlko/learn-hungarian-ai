    "paras": [
      [
        {
          "who": "A",
          "hu": "Halló, Dani! Hol vagy?",
          "ru": "Алло, Дани! Ты где?",
          "en": "Hello, Dani! Where are you?"
        },
        {
          "who": "B",
          "hu": "Szia! A téren, a híd mellett.",
          "ru": "Привет! На площади, у моста.",
          "en": "Hi! On the square, next to the bridge."
        },
        {
          "who": "A",
          "hu": "Én is a téren vagyok, de nem látlak.",
          "ru": "Я тоже на площади, но тебя не вижу.",
          "en": "I am on the square too, but I cannot see you."
        },
        {
          "who": "B",
          "hu": "Jaj, melyik téren vagy?",
          "ru": "Ой, на какой ты площади?",
          "en": "Oh, which square are you on?"
        },
        {
          "who": "A",
          "hu": "Az állomásnál. Te hol vagy?",
          "ru": "У вокзала. А ты где?",
          "en": "At the station. Where are you?"
        },
        {
          "who": "B",
          "hu": "Hát, ez nem ugyanaz a tér!",
          "ru": "Ну, это не та же площадь!",
          "en": "Well, it is not the same square!"
        },
        {
          "who": "A",
          "hu": "Oké, felszállok a metróra. Hány megálló?",
          "ru": "Ладно, сажусь на метро. Сколько остановок?",
          "en": "OK, I am getting on the metro. How many stops?"
        },
        {
          "who": "B",
          "hu": "Csak kettő. Várlak a megállónál.",
          "ru": "Всего две. Жду тебя на остановке.",
          "en": "Only two. I will wait at the stop."
        },
        {
          "who": "A",
          "hu": "Melyik vonalon megyek?",
          "ru": "По какой линии мне ехать?",
          "en": "Which line do I take?"
        },
        {
          "who": "B",
          "hu": "Az első vonalon. Nem nehéz.",
          "ru": "По первой линии. Это не сложно.",
          "en": "On the first line. It is not hard."
        },
        {
          "who": "A",
          "hu": "Értem. Jó, megyek. Pá!",
          "ru": "Понятно. Хорошо, еду. Пока!",
          "en": "Got it. OK, I'm on my way. Bye!"
        },
        {
          "who": "B",
          "hu": "Szia, gyere gyorsan, várlak!",
          "ru": "Пока, приезжай скорее, жду!",
          "en": "Bye, come quickly, I'm waiting!"
        }
      ]
    ]
